# Test PDFs and extraction outputs — never commit user data
research/test_pdfs/*
!research/test_pdfs/.gitkeep
research/results/by_pdf/*
!research/results/by_pdf/.gitkeep
research/results/*
!research/results/by_pdf/
!research/results/.gitkeep
research/report.html

# Bundled binary assets
shared/pn_master.bloom
deploy/_pymods/shared/pn_master.bloom

# deploy/_pymods/ is NOT ignored, on purpose: GitHub Pages serves this repo
# with no build step, so whatever app.js fetches at runtime must already be
# committed. `deploy/_pymods/` used to be excluded here as a "build
# artifact," which is correct instincts for a pipeline WITH a build step and
# wrong for one without -- it meant the entire Python module mirror
# (including manifest.json) would never have reached a real push. Run
# `python3 deploy/build.py` and commit the result before every push.

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*~

# Marketing assets — keep the markdown, gitignore the screenshots
# (they live in the consultancy site's repo, not this one)
marketing/assets/*.png
