# Test PDFs and extraction outputs — never commit user data
research/test_pdfs/*
!research/test_pdfs/.gitkeep
research/results/by_pdf/*
!research/results/by_pdf/.gitkeep
research/results/*
!research/results/by_pdf/
!research/results/.gitkeep
research/report.html

# Bundled binary assets
shared/pn_master.bloom
deploy/_pymods/shared/pn_master.bloom

# Build artifact -- .github/workflows/pages.yml runs `python3 deploy/build.py`
# fresh on every deploy, so this can never silently go stale relative to
# shared/, sheet_types/, or levels/L1_text/. (History: this was gitignored,
# then briefly un-ignored and committed directly when GitHub Pages had no
# build step of its own, then re-ignored once the Pages workflow took over
# rebuilding it. If you ever remove that workflow's build step, re-commit
# this directory the same way, or the live site will silently serve stale
# Python logic.)
deploy/_pymods/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*~

# Marketing assets — keep the markdown, gitignore the screenshots
